<!DOCTYPE html>
<html lang="en" class="h-full" data-controller="rails_exception_log-theme" data-rails_exception_log-theme-theme-value="<%= RailsExceptionLog.configuration.theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="turbo-prefetch" content="false">
  <title><%= content_for?(:title) ? yield(:title) : RailsExceptionLog.configuration.application_name || "RailsExceptionLog" %></title>

  <%= stylesheet_link_tag "rails_exception_log/application", "data-turbo-track": "reload" %>

  <%= javascript_include_tag "rails_exception_log/application", defer: true, "data-turbo-track": "reload" %>

  <% if respond_to?(:turbo_refreshes_with) %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
  <% end %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>
<%
  exception_count = RailsExceptionLog::LoggedException.count
  monitor_menu_active = controller_path == "rails_exception_log/logged_exceptions"
  resources_menu_active = RailsExceptionLog.configuration.sidebar_links.any? do |link|
    link[:url].to_s == request.path
  end
%>
<body class="h-full <%= RailsExceptionLog.configuration.body_class %>" data-controller="rails_exception_log-sidebar">
  <div class="min-h-full flex">

    <%# Sidebar %>
    <aside id="rn-desktop-sidebar" class="rn-sidebar" data-rails_exception_log-sidebar-target="sidebar">
      <%# Logo %>
      <div class="rn-sidebar-logo">
        <%= link_to root_path, class: "flex items-center gap-2.5" do %>
          <div class="rn-logo-icon">⚡</div>
          <span class="rn-logo-copy">
            <span class="rn-logo-text"><%= RailsExceptionLog.configuration.application_name || "RailsExceptionLog" %></span>
            <span class="rn-logo-subtitle">Exception log</span>
          </span>
        <% end %>
      </div>

      <%# Navigation %>
      <nav class="rn-sidebar-nav" aria-label="RailsExceptionLog navigation">
        <details class="rn-nav-section" data-action="toggle->rails_exception_log-sidebar#closeOtherMenus" <%= "open" if monitor_menu_active %>>
          <summary class="rn-nav-section-toggle">
            <span class="rn-nav-section-title">
              <span class="rn-nav-section-icon"><svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l2.25-6 4.5 12 2.25-6H21" /></svg></span>
              <span>Monitor</span>
            </span>
            <svg class="rn-nav-section-chevron" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </summary>
          <div class="rn-nav-section-items">
        <%= link_to root_path,
          class: "rn-nav-item #{request.path == rails_exception_log.root_path ? 'active' : ''}" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
          Exceptions
          <% if exception_count > 0 %>
            <span class="rn-nav-badge"><%= number_with_delimiter(exception_count) %></span>
          <% end %>
        <% end %>

          </div>
        </details>

        <details class="rn-nav-section" data-action="toggle->rails_exception_log-sidebar#closeOtherMenus" <%= "open" if resources_menu_active %>>
          <summary class="rn-nav-section-toggle">
            <span class="rn-nav-section-title">
              <span class="rn-nav-section-icon"><svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6H6.75A3.75 3.75 0 003 9.75v7.5A3.75 3.75 0 006.75 21h7.5A3.75 3.75 0 0018 17.25V13.5m-6-1.5L21 3m0 0h-5.25M21 3v5.25" /></svg></span>
              <span>Resources</span>
            </span>
            <svg class="rn-nav-section-chevron" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </summary>
          <div class="rn-nav-section-items">

        <% if main_app.respond_to?(:root_path) %>
          <%= link_to main_app.root_path,
            class: "rn-nav-item rn-nav-item--muted" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            Admin Panel
          <% end %>
        <% end %>

        <%= link_to feed_logged_exceptions_path(format: :rss),
          class: "rn-nav-item rn-nav-item--muted" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 00-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
          RSS Feed
        <% end %>

        <% RailsExceptionLog.configuration.sidebar_links.each do |link| %>
          <%= link_to link[:url],
            class: "rn-nav-item",
            target: link[:target] || "_self" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            <%= link[:label] %>
          <% end %>
        <% end %>
          </div>
        </details>
      </nav>

      <%# Footer %>
      <div class="rn-sidebar-footer">
        <span class="rn-sidebar-status"><span class="rn-status-dot"></span>Operational</span>
        <span>v<%= RailsExceptionLog::VERSION %></span>
      </div>
    </aside>

    <%# Main Content %>
    <div class="flex-1 flex flex-col min-w-0">
      <%# Top Bar %>
      <header class="rn-topbar">
        <div class="rn-topbar-title">
          <button type="button"
            class="rn-icon-btn rn-sidebar-toggle"
            data-action="click->rails_exception_log-sidebar#toggle"
            data-rails_exception_log-sidebar-target="toggleButton"
            title="Toggle navigation"
            aria-label="Hide navigation"
            aria-controls="rn-desktop-sidebar rn-mobile-sidebar"
            aria-expanded="true">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
          </button>
          <div>
            <span class="rn-topbar-heading"><%= RailsExceptionLog.configuration.application_name || "RailsExceptionLog" %></span>
            <span class="rn-topbar-subtitle">Exception log</span>
          </div>
        </div>

        <div class="rn-topbar-actions">
          <% if RailsExceptionLog.configuration.keyboard_shortcuts && controller_path == "rails_exception_log/logged_exceptions" && action_name == "index" %>
            <button type="button"
              id="rn-shortcuts-button"
              class="rn-icon-btn"
              data-action="click->rails_exception_log-sidebar#toggleShortcuts"
              title="Keyboard shortcuts"
              aria-label="Open keyboard shortcuts"
              aria-haspopup="dialog"
              aria-expanded="false">
              <span class="rn-kbd" aria-hidden="true">?</span>
            </button>
          <% end %>

          <button type="button"
            class="rn-icon-btn"
            data-action="click->rails_exception_log-theme#toggle"
            title="Toggle theme (t)"
            aria-label="Toggle color theme">
            <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
            <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
          </button>

          <% if main_app.respond_to?(:root_path) %>
            <%= link_to main_app.root_path,
              class: "rn-icon-btn",
              title: "Back to app" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            <% end %>
          <% end %>
        </div>
      </header>

      <%# Flash Messages %>
      <% if notice.present? %>
        <div class="mx-4 sm:mx-6 mt-4">
          <div class="rn-alert rn-alert-success">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            <p class="text-sm font-medium"><%= notice %></p>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mx-4 sm:mx-6 mt-4">
          <div class="rn-alert rn-alert-error">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
            <p class="text-sm font-medium"><%= alert %></p>
          </div>
        </div>
      <% end %>

      <%# Main Content %>
      <main class="rn-main flex-1 p-4 sm:p-6">
        <%= yield %>
      </main>

      <footer class="rn-footer">
        <span>RailsExceptionLog <span class="rn-footer-version">v<%= RailsExceptionLog::VERSION %></span></span>
        <span class="rn-footer-credit">
          Built by
          <a href="https://github.com/tamiru" target="_blank" rel="noopener noreferrer">Tamiru Hailu</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/tamiru/rails_exception_log" target="_blank" rel="noopener noreferrer" class="rn-footer-github">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7A11.3 11.3 0 00.7 12c0 5 3.2 9.2 7.7 10.7.6.1.8-.3.8-.6v-2.2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.1 1.2A10.8 10.8 0 0112 6.5c1 0 1.9.1 2.8.4 2.2-1.5 3.1-1.2 3.1-1.2.6 1.6.2 2.8.1 3.1.7.8 1.2 1.9 1.2 3.1 0 4.3-2.6 5.3-5.1 5.6.4.4.8 1.1.8 2.1v2.5c0 .4.2.7.8.6A11.3 11.3 0 0023.3 12 11.3 11.3 0 0012 .7z" /></svg>
            GitHub
          </a>
        </span>
      </footer>
    </div>
  </div>

  <%# Mobile sidebar overlay %>
  <div class="rn-overlay" data-rails_exception_log-sidebar-target="overlay" data-action="click->rails_exception_log-sidebar#close"></div>

  <%# Mobile sidebar drawer %>
  <div id="rn-mobile-sidebar" class="rn-mobile-sidebar" data-rails_exception_log-sidebar-target="drawer">
    <div class="rn-sidebar-logo">
      <%= link_to root_path, class: "flex items-center gap-2.5" do %>
        <div class="rn-logo-icon">⚡</div>
        <span class="rn-logo-copy">
          <span class="rn-logo-text"><%= RailsExceptionLog.configuration.application_name || "RailsExceptionLog" %></span>
          <span class="rn-logo-subtitle">Exception log</span>
        </span>
      <% end %>
      <button type="button" class="rn-icon-btn" data-action="click->rails_exception_log-sidebar#close" aria-label="Close navigation">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <%= render "layouts/rails_exception_log/sidebar_navigation",
      exception_count: exception_count,
      monitor_menu_active: monitor_menu_active,
      resources_menu_active: resources_menu_active %>
    <div class="rn-sidebar-footer">
      <span class="rn-sidebar-status"><span class="rn-status-dot"></span>Operational</span>
      <span>v<%= RailsExceptionLog::VERSION %></span>
    </div>
  </div>

  <%= turbo_frame_tag :remote_modal, target: :_top %>
</body>
</html>
