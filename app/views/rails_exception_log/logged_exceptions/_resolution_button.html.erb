<%# The detail header's Resolve / Reopen button. Replaced in place by the
    resolve and reopen responses, so it always matches the state.
    Locals:
      exception — the LoggedException shown
%>
<span id="rn-resolution-button" class="rn-resolution-button">
  <% if exception.has_attribute?(:resolved_at) %>
    <% if exception.resolved? %>
      <%= button_to reopen_logged_exception_path(exception),
                    class: "rn-btn rn-btn-ghost rn-btn-sm rn-btn-bordered",
                    title: "Resolved #{exception.resolved_at.strftime('%b %d %H:%M')}#{" by #{exception.resolved_by}" if exception.resolved_by.present?}" do %>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
        Reopen
      <% end %>
    <% else %>
      <%= button_to resolve_logged_exception_path(exception),
                    class: "rn-btn rn-btn-sm rn-btn-success",
                    title: "Mark as fixed. It reopens by itself if it happens again." do %>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
        Resolve
      <% end %>
    <% end %>
  <% end %>
</span>
