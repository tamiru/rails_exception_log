<div id="exceptions-content" class="rn-exceptions-results overflow-hidden">
  <%# ─── Quick Filters ──────────────────────────────────────── %>
  <nav class="rn-quick-filters" aria-label="Quick filters">
    <% quick_filters.each do |chip| %>
      <%= link_to logged_exceptions_path(quick_filter_params(chip)),
                  class: "rn-quick-filter#{' is-active' if chip[:active]}",
                  aria: { current: (chip[:active] ? "true" : nil) },
                  title: (chip[:active] ? "Remove the #{chip[:label]} filter" : "Show only #{chip[:label].downcase}"),
                  data: { turbo_frame: "_top" } do %>
        <% if chip[:active] %>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
        <% end %>
        <%= chip[:label] %>
      <% end %>
    <% end %>
  </nav>

  <% if @exceptions.empty? %>
    <div class="py-16 text-center">
      <div class="w-12 h-12 rounded-full flex items-center justify-center mx-auto" style="background: var(--rn-success-light)">
        <svg class="w-6 h-6" style="color: var(--rn-success)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="mt-3 text-sm font-medium" style="color: var(--rn-text)"><%= t(".empty") %></p>
      <p class="mt-1 text-xs" style="color: var(--rn-text-muted)">No exceptions match your current filters.</p>
      <% if filtered? %>
        <%= link_to "Clear filters", logged_exceptions_path, class: "mt-3 inline-block text-xs font-medium", style: "color: var(--rn-primary)" %>
      <% end %>
    </div>
  <% else %>
    <%# ─── Table Header Bar ───────────────────────────────────── %>
    <div class="rn-exceptions-toolbar" style="background: var(--rn-bg-secondary); border-bottom: 1px solid var(--rn-border-light)">
      <div class="rn-exceptions-toolbar-summary">
        <span class="text-xs font-medium" style="color: var(--rn-text-secondary)">
          <span class="font-semibold" style="color: var(--rn-text)"><%= number_with_delimiter(@pagy.count) %></span>
          <%= "exception".pluralize(@pagy.count) %>
          <% if filtered? %>
            <span style="color: var(--rn-text-muted)">(filtered)</span>
          <% end %>
        </span>

        <%# Rows, or one row per exception class %>
        <div class="rn-view-toggle" role="group" aria-label="View">
          <%= link_to "Rows",
                      logged_exceptions_path(params_filters.except(:group)),
                      class: "rn-view-toggle-option#{' is-active' unless grouped_by_class?}",
                      aria: { current: (grouped_by_class? ? nil : "true") },
                      data: { turbo_frame: "_top" } %>
          <%= link_to "By class",
                      logged_exceptions_path(params_filters.merge(group: "class")),
                      class: "rn-view-toggle-option#{' is-active' if grouped_by_class?}",
                      aria: { current: (grouped_by_class? ? "true" : nil) },
                      data: { turbo_frame: "_top" } %>
        </div>

        <%# Page size selector %>
        <% unless grouped_by_class? %>
        <div class="rn-page-size" role="group" aria-label="Rows per page">
          <span class="rn-page-size-label">Per page</span>
          <% page_size_choices.each do |size| %>
            <%= link_to size.to_s,
              logged_exceptions_path(params_filters.merge(per_page: size)),
              class: "rn-btn rn-btn-xs #{size == page_size ? 'rn-btn-primary' : 'rn-btn-ghost'}",
              aria: { current: (size == page_size ? "true" : nil) },
              data: { turbo_frame: "exceptions" } %>
          <% end %>
        </div>
        <% end %>
      </div>

      <div class="rn-exceptions-toolbar-actions">
        <%# Keyboard hint %>
        <span class="rn-shortcuts-hint text-xs flex items-center gap-1" style="color: var(--rn-text-muted)">
          <span class="rn-kbd">?</span> shortcuts
        </span>

        <%= link_to destroy_all_logged_exceptions_path(params_filters),
          class: "rn-btn rn-btn-ghost rn-btn-sm",
          style: "color: var(--rn-danger); border-color: var(--rn-danger)",
          data: { turbo_method: :post, turbo_confirm: t(".confirm_delete_visible"), turbo_stream: true } do %>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
          Delete all
        <% end %>
      </div>
    </div>

    <% if grouped_by_class? %>
      <%= render "class_groups" %>
    <% else %>
    <%# ─── Bulk Actions (shown once rows are ticked) ──────────── %>
    <%= form_with url: bulk_logged_exceptions_path,
                  id: "rn-bulk-form",
                  class: "rn-bulk-bar",
                  html: { hidden: true, "data-rails_exception_log-target" => "bulkBar" },
                  data: { turbo_frame: "_top" } do %>
      <%= hidden_field_tag :return_to, logged_exceptions_path(params_filters), id: nil %>
      <span class="rn-bulk-count" data-rails_exception_log-target="bulkCount" aria-live="polite">0 selected</span>

      <div class="rn-bulk-actions">
        <% if exception_feature?(:muted) %>
          <button type="submit" name="bulk_action" value="mute" class="rn-btn rn-btn-ghost rn-btn-sm">Mute</button>
          <button type="submit" name="bulk_action" value="unmute" class="rn-btn rn-btn-ghost rn-btn-sm">Unmute</button>
        <% end %>

        <% if exception_feature?(:priority) %>
          <div class="rn-bulk-group">
            <%= select_tag :priority,
                           options_for_select([["Critical", "critical"], ["High", "high"], ["Medium", "medium"], ["Low", "low"]]),
                           include_blank: "Priority…",
                           class: "rn-select rn-select-sm",
                           id: "rn-bulk-priority",
                           aria: { label: "Priority for the selected exceptions" } %>
            <button type="submit" name="bulk_action" value="priority" class="rn-btn rn-btn-ghost rn-btn-sm">Set</button>
          </div>
        <% end %>

        <% if exception_feature?(:assigned_to) %>
          <div class="rn-bulk-group">
            <%= text_field_tag :assigned_to, nil,
                               class: "rn-input rn-input-sm",
                               id: "rn-bulk-assignee",
                               placeholder: "Assign to…",
                               list: "rn-bulk-assignees",
                               autocomplete: "off",
                               aria: { label: "Assign the selected exceptions to" },
                               data: { action: "keydown.enter->rails_exception_log#submitBulkAssign" } %>
            <datalist id="rn-bulk-assignees">
              <% @assignees.each do |name| %>
                <option value="<%= name %>"></option>
              <% end %>
            </datalist>
            <button type="submit" name="bulk_action" value="assign" class="rn-btn rn-btn-ghost rn-btn-sm" data-rn-bulk="assign">Assign</button>
          </div>
        <% end %>

        <button type="submit"
                name="bulk_action"
                value="delete"
                class="rn-btn rn-btn-ghost rn-btn-sm rn-bulk-delete"
                data-action="click->rails_exception_log#confirmBulkDelete">Delete</button>
        <button type="button"
                class="rn-btn rn-btn-ghost rn-btn-sm"
                data-action="click->rails_exception_log#clearSelection">Clear</button>
      </div>
    <% end %>

    <%# ─── Exception Table ────────────────────────────────────── %>
    <div class="rn-table-wrap">
      <table class="rn-table rn-exceptions-table">
        <caption class="sr-only">Logged application exceptions</caption>
        <thead>
          <tr>
            <th class="rn-col-select">
              <input type="checkbox"
                     class="rn-checkbox"
                     data-rails_exception_log-target="selectAll"
                     data-action="change->rails_exception_log#toggleAll"
                     aria-label="Select all exceptions on this page">
            </th>
            <%= content_tag :th, sort_link(@q, :exception_class, "Exception", hide_indicator: true),
                        class: "rn-col-exception #{sort_header_class(:exception_class)}",
                        aria: { sort: sort_header_aria(:exception_class) } %>
            <%= content_tag :th, sort_link(@q, :controller_name, "Source", hide_indicator: true),
                        class: "rn-col-source #{sort_header_class(:controller_name)}",
                        aria: { sort: sort_header_aria(:controller_name) } %>
            <%= content_tag :th, sort_link(@q, :message, "Message", hide_indicator: true),
                        class: "rn-col-message #{sort_header_class(:message)}",
                        aria: { sort: sort_header_aria(:message) } %>
            <% if exception_feature?(:occurrence_count) %>
              <%= content_tag :th, sort_link(@q, :occurrence_count, "Count", hide_indicator: true),
                        class: "rn-col-count #{sort_header_class(:occurrence_count)}",
                        aria: { sort: sort_header_aria(:occurrence_count) } %>
            <% else %>
              <th class="rn-col-count">Count</th>
            <% end %>
            <% if @show_trends %>
              <th class="rn-col-trend">7 days</th>
            <% end %>
            <%= content_tag :th, sort_link(@q, :created_at, "Last Seen", hide_indicator: true),
                        class: "rn-col-time #{sort_header_class(:created_at)}",
                        aria: { sort: sort_header_aria(:created_at) } %>
            <th class="rn-col-actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody data-rails_exception_log-target="exceptionList">
          <% @exceptions.each_with_index do |exception, index| %>
            <tr id="<%= dom_id(exception) %>"
                class="group"
                tabindex="0"
                aria-label="View <%= exception.exception_class %>: <%= exception.display_message.presence || 'No message' %>"
                data-action="click->rails_exception_log#selectRow keydown.enter->rails_exception_log#selectRow keydown.space->rails_exception_log#selectRow"
                data-url="<%= logged_exception_path(exception, params_filters) %>"
                data-index="<%= index %>"
                data-rails_exception_log-index-param="<%= index %>">

              <%# Row selection for bulk actions %>
              <td class="rn-col-select">
                <input type="checkbox"
                       class="rn-checkbox"
                       name="ids[]"
                       value="<%= exception.id %>"
                       form="rn-bulk-form"
                       data-rails_exception_log-target="rowCheckbox"
                       data-action="change->rails_exception_log#updateBulk"
                       aria-label="Select <%= exception.exception_class %>">
              </td>

              <%# Exception class with severity indicator %>
              <td class="rn-col-exception">
                <div class="rn-exception-cell">
                  <span class="rn-severity-dot rn-severity-<%= severity_for(exception) %>" aria-hidden="true"></span>
                  <div class="min-w-0">
                    <%= link_to breakable_class_name(exception.exception_class),
                                logged_exception_path(exception, params_filters),
                                class: "rn-exception-name rn-row-link",
                                title: exception.exception_class,
                                tabindex: -1,
                                data: { turbo_frame: "_top" } %>
                    <% if exception.respond_to?(:fingerprint) && exception.fingerprint.present? %>
                      <span class="rn-row-meta rn-mono" title="Fingerprint <%= exception.fingerprint %>">#<%= exception.fingerprint.first(10) %></span>
                    <% end %>
                    <% if exception.status_badges.any? %>
                      <span class="rn-row-badges"><%= status_badges_for(exception) %></span>
                    <% end %>
                  </div>
                </div>
              </td>

              <%# Source (controller + action) %>
              <td class="rn-col-source">
                <div class="rn-source rn-mono" title="<%= [exception.controller_name, exception.action_name].compact.join('#') %>">
                  <span class="rn-source-controller"><%= exception.controller_name.presence || "—" %></span>
                  <% if exception.action_name.present? %>
                    <span class="rn-source-action">#<%= exception.action_name %></span>
                  <% end %>
                </div>
              </td>

              <%# Message (truncated) %>
              <td class="rn-col-message">
                <div class="rn-msg" title="<%= exception.display_message %>">
                  <%= exception.display_message.presence || "No message" %>
                </div>
                <% if (location_label = exception.location_label) %>
                  <span class="rn-row-location rn-mono" title="<%= location_label %>"><%= location_label %></span>
                <% end %>
              </td>

              <%# Occurrence count %>
              <td class="rn-col-count">
                <span class="rn-occurrence-count" title="<%= pluralize(exception_occurrence_count(exception), 'occurrence') %>"><%= number_with_delimiter(exception_occurrence_count(exception)) %></span>
              </td>

              <%# Occurrences per day over the last week %>
              <% if @show_trends %>
                <td class="rn-col-trend"><%= trend_sparkline(@trends[exception.id]) %></td>
              <% end %>

              <%# Time (relative) %>
              <td class="rn-col-time rn-date">
                <time datetime="<%= exception.created_at.iso8601 %>"
                      title="<%= exception.created_at.strftime("%B %d, %Y at %I:%M:%S %p %Z") %>"><%= pretty_exception_date(exception) %></time>
              </td>

              <%# Actions (delete on hover) %>
              <td class="rn-col-actions" style="text-align: right">
                <div class="rn-row-actions">
                  <%= link_to logged_exception_path(exception, params_filters),
                    class: "rn-icon-btn",
                    style: "color: var(--rn-text-muted)",
                    title: "Open details",
                    aria: { label: "Open #{exception.exception_class} details" },
                    data: { turbo_frame: "_top" } do %>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                  <% end %>
                  <%= link_to logged_exception_path(exception),
                    class: "rn-icon-btn",
                    style: "color: var(--rn-danger)",
                    title: "Delete",
                    aria: { label: "Delete #{exception.exception_class}" },
                    data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete"), turbo_stream: true } do %>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# ─── Pagination ─────────────────────────────────────────── %>
    <% if @pagy.pages > 1 %>
      <div class="rn-pagination">
        <p class="text-xs" style="color: var(--rn-text-muted)">
          Showing <span class="font-medium" style="color: var(--rn-text-secondary)"><%= @pagy.from %></span>
          to <span class="font-medium" style="color: var(--rn-text-secondary)"><%= @pagy.to %></span>
          of <span class="font-medium" style="color: var(--rn-text-secondary)"><%= @pagy.count %></span>
        </p>
        <div><%== rails_exception_log_pagy_nav(@pagy) %></div>
      </div>
    <% end %>
    <% end %>
  <% end %>
</div>
